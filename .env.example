# Frontend API base (blank uses http://localhost:8000)
VITE_API_BASE_URL=

# Backend API settings (set in the environment used to start FastAPI)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=

# NASA FIRMS MAP_KEY (obtain your own free key; never commit a populated .env)
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_NOAA21_NRT
FIRMS_AREA=79.92,12.95,80.42,13.42
FIRMS_LOOKBACK_DAYS=5

# Optional; documented public Overpass service is the default
OVERPASS_URL=
OVERPASS_TIMEOUT_SECONDS=40
